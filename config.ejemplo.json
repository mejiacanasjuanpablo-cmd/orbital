{
  "title": "Panel del PC",
  "relojes": [
    { "nombre": "Nueva York", "zona": "America/New_York" },
    { "nombre": "San Francisco", "zona": "America/Los_Angeles" },
    { "nombre": "Madrid", "zona": "Europe/Madrid" }
  ],
  "clima": { "activo": false, "ciudad": "", "lat": null, "lon": null },
  "pomodoro": { "enfoque": 25, "descanso": 5, "largo": 15 },
  "groups": [
    {
      "name": "Multimedia",
      "place": "media",
      "items": [
        { "id": "prev", "label": "Anterior", "icon": "prev", "type": "media", "key": "prev" },
        { "id": "playpause", "label": "Play / Pausa", "icon": "play", "type": "media", "key": "playpause" },
        { "id": "next", "label": "Siguiente", "icon": "next", "type": "media", "key": "next" }
      ]
    },
    {
      "name": "Atajos",
      "place": "atajos",
      "items": [
        { "id": "explorer", "label": "Explorador", "icon": "folder", "color": "#f5b84b", "type": "open", "target": "explorer.exe" },
        { "id": "downloads", "label": "Descargas", "icon": "download", "color": "#38bdf8", "type": "open", "target": "explorer.exe", "args": "shell:Downloads" },
        { "id": "documents", "label": "Documentos", "icon": "briefcase", "color": "#c084fc", "type": "open", "target": "explorer.exe", "args": "shell:Personal" },
        { "id": "browser", "label": "Navegador", "icon": "globe", "color": "#2dd4bf", "type": "open", "target": "https://www.google.com" },
        { "id": "calc", "label": "Calculadora", "icon": "calculator", "color": "#94a3b8", "type": "open", "target": "calc.exe" },
        { "id": "screenshot", "label": "Recorte", "icon": "scissors", "color": "#f472b6", "type": "open", "target": "ms-screenclip:" },
        { "id": "taskmgr", "label": "Tareas", "icon": "activity", "color": "#4ade80", "type": "keys", "keys": "^+{ESC}" },
        { "id": "showdesktop", "label": "Escritorio", "icon": "monitor", "color": "#818cf8", "type": "command", "command": "(New-Object -ComObject Shell.Application).ToggleDesktop()" }
      ]
    },
    {
      "name": "Comandos",
      "place": "comandos",
      "items": [
        { "id": "topcpu", "label": "Top CPU", "icon": "flame", "color": "#fb923c", "type": "command", "command": "Get-Process | Sort-Object CPU -Descending | Select-Object -First 10 Name, @{n='CPU(s)';e={[math]::Round($_.CPU,1)}}, @{n='RAM(MB)';e={[math]::Round($_.WorkingSet64/1MB)}} | Format-Table -AutoSize | Out-String -Width 60" },
        { "id": "ip", "label": "IP local", "icon": "wifi", "color": "#38bdf8", "type": "command", "command": "Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike '127.*' -and $_.IPAddress -notlike '169.254.*' } | Select-Object InterfaceAlias, IPAddress | Format-Table -AutoSize | Out-String -Width 60" },
        { "id": "uptime", "label": "Uptime", "icon": "clock", "color": "#2dd4bf", "type": "command", "command": "$u = (Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime; 'Encendido hace {0} d {1} h {2} min' -f $u.Days, $u.Hours, $u.Minutes" },
        { "id": "lock", "label": "Bloquear", "icon": "lock", "color": "#f87171", "type": "command", "command": "rundll32.exe user32.dll,LockWorkStation", "confirm": true },
        { "id": "sleep", "label": "Suspender", "icon": "moon", "color": "#a78bfa", "type": "command", "command": "Add-Type -AssemblyName System.Windows.Forms; [System.Windows.Forms.Application]::SetSuspendState('Suspend', $false, $false) | Out-Null", "confirm": true }
      ]
    }
  ]
}
